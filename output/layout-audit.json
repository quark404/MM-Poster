    "size_pt": 20
  },
  {
    "text": "1. Reference drift",
    "x": 32,
    "y": 425,
    "width": 367,
    "height": 11.19011111111111,
    "size_pt": 26
  },
  {
    "text": "Textual references can switch between similar objects during multi-step reasoning.",
