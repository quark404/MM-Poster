  },
  {
    "text": "Same entity. Same ID. Different views.",
    "x": 441,
    "y": 341,
    "width": 367,
    "height": 11.620499999999998,
    "size_pt": 27
  },
  {
    "text": "Reasoning anchor = name + ID + view + point.",
    "x": 441,
    "y": 367,
    "width": 367,
    "height": 11.19011111111111,
    "size_pt": 26
  },
  {
    "text": "Introduce the anchor once; reuse its identity throughout the reasoning chain.",
    "x": 441,
    "y": 405,
    "width": 367,
    "height": 11.19011111111111,
    "size_pt": 26
  },
  {
    "text": "Our insight",
    "x": 441,
    "y": 452,
    "width": 271,
    "height": 11.19011111111111,
    "size_pt": 26
  },
  {
    "text": "Persistent IDs connect visual grounding, intermediate steps and the final answer.",
